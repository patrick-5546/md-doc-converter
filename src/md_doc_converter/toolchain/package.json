{
  "name": "md-doc-converter",
  "version": "0.1.0",
  "description": "Pinned renderer packages installed by md-doc-converter setup",
  "private": true,
  "type": "module",
  "dependencies": {
    "@mermaid-js/mermaid-cli": "^11.17.0",
    "mermaid-filter": "^1.4.7",
    "pagedjs-cli": "^0.4.3",
    "puppeteer": "^25.16.0"
  },
  "overrides": {
    "mermaid-filter": {
      "@mermaid-js/mermaid-cli": "$@mermaid-js/mermaid-cli"
    },
    "pagedjs-cli": {
      "puppeteer": "$puppeteer"
    }
  }
}
